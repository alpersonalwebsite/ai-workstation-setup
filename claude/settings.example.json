{
  "permissions": {
    "deny": [
      "Read(//**/.env*)",
      "Read(//**/*.env)",
      "Read(//**/secrets/**)",
      "Read(//**/credentials*)",
      "Read(//**/*.pem)",
      "Read(//**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/credentials)",
      "Read(~/.aws/sso/cache/**)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.docker/config.json)",
      "Read(~/.kube/config)",
      "Edit(//**/.env*)",
      "Edit(//**/*.env)",
      "Edit(//**/secrets/**)",
      "Edit(//**/credentials*)",
      "Edit(//**/*.pem)",
      "Edit(//**/*.key)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/credentials)",
      "Edit(~/.aws/sso/cache/**)",
      "Edit(~/.config/gh/hosts.yml)",
      "Edit(~/.netrc)",
      "Edit(~/.npmrc)",
      "Edit(~/.docker/config.json)",
      "Edit(~/.kube/config)"
    ]
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/block-secret-echo.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/validate-gitignore.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/gitleaks-check.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/scan-claude-writes.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/check-uncommitted.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 2
  },
  "cleanupPeriodDays": 365,
  "tui": "fullscreen",
  "theme": "dark"
}
