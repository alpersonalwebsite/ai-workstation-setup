{
  "permissions": {
    "deny": [
      "Read(.env*)",
      "Read(*.env)",
      "Read(secrets/**)",
      "Read(credentials*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.aws/credentials)",
      "Read(~/.ssh/**)",
      "Read(~/.config/gh/hosts.yml)",
      "Edit(.env*)",
      "Edit(*.env)",
      "Edit(secrets/**)",
      "Edit(credentials*)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(~/.aws/credentials)",
      "Edit(~/.ssh/**)",
      "Edit(~/.config/gh/hosts.yml)"
    ]
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/block-secret-echo.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/validate-gitignore.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/gitleaks-check.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/scan-claude-writes.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/check-uncommitted.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 2
  },
  "cleanupPeriodDays": 365,
  "tui": "fullscreen",
  "theme": "dark"
}
